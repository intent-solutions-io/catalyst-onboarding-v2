# The CI docs job's one Python dependency (the agent-definition check in .github/workflows/ci.yml), hash-locked like
# base.in so that job has no unpinned install. The job runs on the hosted runner's system Python (3.12), not the
# 3.14 container. Compile with:
#   uv pip compile --python-version 3.12 --python-platform x86_64-unknown-linux-gnu \
#     --generate-hashes --no-header requirements/docs.in -o requirements/docs.txt
pyyaml==6.0.2

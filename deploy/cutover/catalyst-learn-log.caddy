# Generated by scripts/render_caddyfile.py from config.redaction.PRIVATE_PATHS (026 sections 8 and 9).
# The Learn site's access log at the cutover: the token segment of every R2 path is redacted. It replaces the live
# site's own `log` block (a cutover precondition, checked in the live read); the error log needs the same filter.
log {
	output stdout
	format filter {
			wrap json
			request>uri regexp (?i)^/+((?:%43|%63|c)(?:%4f|%6f|o)(?:%4e|%6e|n)(?:%46|%66|f)(?:%49|%69|i)(?:%52|%72|r)(?:%4d|%6d|m)|(?:%53|%73|s)(?:%45|%65|e)(?:%54|%74|t)(?:%55|%75|u)(?:%50|%70|p)|(?:%57|%77|w)(?:%49|%69|i)(?:%54|%74|t)(?:%48|%68|h)(?:%44|%64|d)(?:%52|%72|r)(?:%41|%61|a)(?:%57|%77|w))(?:/|%2f)+[^/?#]+ /$1/REDACTED
		}
}

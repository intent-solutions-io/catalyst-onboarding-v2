# R2, the return routes (026 section 9): confirmation, password-setup and withdrawal links go to Catalyst v2. Once v2
# has applicants their emailed links point here, so R2 stays imported through any R1 rollback until no v2 applicant
# holds a live link. Token paths: the Learn site's log must be catalyst-learn-log.caddy, which redacts them (026 section 8).
@catalyst_r2 path /confirm/* /setup/* /withdraw/*
handle @catalyst_r2 {
	# The default is the v2 web socket the host's proxy shares (026 section 4). A placeholder is read when Caddy
	# starts, never at a reload, so the default (not an exported variable) is what a reload of the live site uses.
	reverse_proxy {$CATALYST_UPSTREAM:unix//run/catalyst/web.sock} {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up -X-Forwarded-Host
	}
}
